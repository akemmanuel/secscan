# LLM (OpenCode Zen by default)
SECSCAN_BASE_URL=https://opencode.ai/zen/v1
SECSCAN_PROVIDER=opencode
SECSCAN_MODEL=deepseek-v4-flash-free
SECSCAN_REASONING=low
# OPENCODE_API_KEY=

# Sengine (required for search / scrape tools)
# Point this at any Sengine-compatible API base — no host is baked into secscan.
SENGINE_BASE=https://your-sengine-host.example/api
SENGINE_API_KEY=sk_sengine_your_key_here

# Scanner
SECSCAN_OUT_DIR=./reports
SECSCAN_BASH_TIMEOUT=120
SECSCAN_BASH_OUTPUT_KB=5
